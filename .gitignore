# Open ScholarPeer working files (may contain confidential paper content)
.brain/

# Open ScholarPeer MCP runtime (venv + server, gitignored)
.open-scholar-peer/

# API keys (never commit)
.env

# Local agent configuration and runtime state. Open ScholarPeer installs and
# manages the marked block in AGENTS.md, while preserving text outside it. This
# repository intentionally ignores the complete project-local file, so custom
# AGENTS.md additions are local-only; do not expect them to synchronize via Git.
.claude/
.mcp.json
AGENTS.md

# .opencode/ is where the Open ScholarPeer installer drops generated artifacts
# (see docs/OSP_FORK_WORKFLOW.md), so it stays ignored by default. The
# paper2task workflow is different: it is source, maintained here, and has to
# sit in .opencode/ because that is the only place opencode looks.
.opencode/*
!.opencode/command/
!.opencode/agent/

# Build products and generated Harbor tasks. Tasks are published to the
# Hugging Face dataset, not committed here.
/build/
/tasks/

# oh-my-claudecode runtime/operational state (session state, plans, logs) —
# .omc/skills/** would be the intentional committable exception if it existed
.omc/
!.omc/skills/

# Local private review trails and Python bytecode
/osp-trails/
__pycache__/

# Python environment and tooling caches. uv writes a self-ignoring .gitignore
# inside .venv/, but naming it here does not depend on that.
/.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Optional per-paper metadata overrides; specs/ is committable when populated

# Raw transfer artifacts (e.g. group-shared review-test zips) are kept locally
# but never committed or published
/papers/.incoming/
